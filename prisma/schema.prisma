
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus{
  DISCOVERED
  RESEARCHED
  DRAFTED
  FAILED
}


model Lead {
  id               String @id @default(cuid())
  createdAt        DateTime @default(now()) 
  companyName      String 
  website          String @unique 
  prospectName     String
  prospectEmail    String?
  title            String
  signal           String
  emailDraft       String?
  status           LeadStatus @default(DISCOVERED)
  deliverability   Json?
  evaluations   Evaluation[] 
}

model Evaluation {
  id               String @id @default(cuid())
  leadId           String
  lead             Lead @relation(fields:[leadId],references:[id])
  score            Int
  criteria         Json 
  feedback         String
  createdAt        DateTime @default(now()) 

}

